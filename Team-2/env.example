# Team 2 calls Team 1; Sectors credentials belong only in Team 1.
MARKETLENS_ASSET_API_BASE_URL=http://127.0.0.1:8000
MARKETLENS_API_BASE_URL=http://127.0.0.1:8001
# Start with one ticker while validating; expand after the P0 live checks.
MARKETLENS_DISCOVERY_UNIVERSE=BBCA
MARKETLENS_CACHE_TTL_SECONDS=300
MARKETLENS_DB_PATH=marketlens.sqlite3

# Optional: without a key, Explain Finding uses a deterministic evidence summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
