SECTORS_API_KEY=replace_me
SECTORS_BASE_URL=https://api.sectors.app
SECTORS_TIMEOUT_SECONDS=20

# Confirmed 2026-09-22 from the Sectors v2 OpenAPI spec (SKILL.md §4/§12).
# The app already defaults to these even if you leave this file blank — only
# override if a real authenticated call ever shows a different shape.
SECTORS_DAILY_PATH=/v2/daily/{symbol}/
SECTORS_FOREIGN_FLOW_PATH=/v2/foreign-flow/{symbol}/

CACHE_TTL_SECONDS=300

# Financial/report data: cache independently from trading series.
COMPANY_REPORT_CACHE_TTL_SECONDS=3600
